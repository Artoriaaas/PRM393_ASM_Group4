# Local ARTEMIS settings. Copy to .env; never commit real credentials.
ARTEMIS_BASE_URL=
ARTEMIS_TOKEN=
ARTEMIS_TEST_ACCOUNT_EMAIL=
ARTEMIS_EVENT_TITLE=
ARTEMIS_DEVICE=emulator-5554
# Model credentials belong to the configured ARTEMIS host/provider.
# The test client does not automatically load this file; export these locally.

# Public Firebase Web client identifiers passed via `flutter run/build web --dart-define=...`
# Never commit secret API keys or service-account.json.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
