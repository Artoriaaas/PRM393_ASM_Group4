{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EventHub — UI Prototype (local demo)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prototype.dart",
      "flutterMode": "debug"
    },
    {
      "name": "EventHub — Firebase app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      "name": "EventHub Web — Mock Leader (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_mock.dart",
      "cwd": "web",
      "deviceId": "chrome"
    },
    {
      "name": "EventHub Web — Mock Admin (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_mock_admin.dart",
      "cwd": "web",
      "deviceId": "chrome"
    },
    {
      "name": "EventHub Web — Firebase app (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "cwd": "web",
      "deviceId": "chrome",
      "args": [
        "--dart-define-from-file=web_env.json"
      ]
    }
  ]
}
