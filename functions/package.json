    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
